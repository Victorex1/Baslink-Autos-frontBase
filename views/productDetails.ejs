<!DOCTYPE html>
<html lang="en">
  <%- include('../partial/head') %>

  <body>
    <%- include('../partial/nav') %>

    <div class="w-screen bg-gray-100 flex justify-center items-center">
      <div class="w-full lg:w-[1024px] p-3">
        <h1 class="font-bold">ITEM DETAILS</h1>
        <div class="flex flex-col items-center w-full my-3 lg:flex-row">
          <div class="w-full p-2 flex flex-wrap-reverse justify-center items-center">

            <div class="w-full phone2:w-[360px] m-2">
              <img src="<%= data.GoodsImage%>" class="w-full" alt="" />
            </div>
          </div>

          <div class="w-full phone3:flex p-2 gap-3 phone3:w-[520px] phone4:w-[550px]">
          <div class="my-3 w-full lg:w-70 text-[10px] ">
            <h2 id="goodsname" class="font-bold text-[20px]">
              <span><%= data.GoodsName%></span> 
            </h2>

            <div class="flex gap-4 items-center">
              <p class="text-red-800 font-bold text-[15px]">₦<%= data.price.toLocaleString()%></p>
               <div
              class="my-1 flex justify-center items-center p-1 rounded-md bg-blue-500 text-white w-20 "
            >
              Quality Product
            </div>
            </div>
            <p class="text-gray-500 font-bold my-1">
              Upgrade your driving exprience with our high quality Products
            </p>
            <div class="my-3 ">
              <div class="my-1 flex items-center">
                <% if(data.type){ %>

                <div class="flex gap-2 items-center w-30">
                  <i class="bi bi-android2 text-blue-500 text-[1.1rem]"></i>
                  <div>
                    <p class="font-bold "><%= data.type%></p>
                    <p class="text-gray-500 ">2.0</p>
                  </div>
                </div>
                <% } %>

                <% if(data.ram || data.storage){ %>
                <div class="flex gap-2 items-center  w-30">
                  <i class="bi bi-floppy text-blue-500 text-[1.1rem]"></i>
                  <div>
                    <p class="font-bold "><span><%= data.ram%></span> RAM</p>
                    <p class="text-gray-500"><span><%= data.storage%></span> ROM</p>
                  </div>
                </div>
                <% } %>
                <% if(data.type = 'Android'){ %>

                <div class="flex gap-2 items-center w-30">
                  <i class="bi bi-badge-hd text-blue-500 text-[1.1rem]"></i>
                  <div>
                    <p class="font-bold ">10.1"</p>
                    <p class="text-gray-500 ">IPS Display</p>
                  </div>
                </div>
                <% } %>

              </div>

              <div class="my-1 flex items-center">
                <% if(data.type = 'Android'){ %>

                <div class="flex gap-2 items-center  w-30">
                  <i class="bi bi-wifi text-blue-500 text-[1.1rem]"></i>
                  <div>
                    <p class="font-bold ">Wifi</p>
                    <p class="text-gray-500 ">built-in</p>
                  </div>
                </div>
                <% } %>
                <% if(data.type = 'Android'){ %>

                <div class="flex gap-2 items-center   w-30">
                  <i class="bi bi-bluetooth text-blue-500 text-[1.1rem]"></i>
                  <div>
                    <p class="font-bold">Bluetooth 5.0</p>
                    <p class="text-gray-500 ">Hand-free Calls</p>
                  </div>
                </div>
                <% } %>
                <% if(data.type = 'Android'){ %>

                <div class="flex gap-2 items-center  w-30">
                  <i class="bi bi-geo-alt text-blue-500 text-[1.1rem]"></i>
                  <div>
                    <p class="font-bold ">GPS</p>
                    <p class="text-gray-500 ">Navigation</p>
                  </div>
                </div>
                <% } %>

              </div>
            </div>

            <div
              class="p-2 rounded-md border border-gray-300 text-sm/9 text-xs"
            >
              <h2 class="font-bold">Compatable with:</h2>
              <div class="flex gap-3 text-[10px] my-2">
                <i class="bi bi-check-circle text-green-500 "></i>
                <p> <b><%= data.carName%> (<%= data.year%>)</b></p>
              </div>
            </div>
          </div>

          <div class="text-[10px] lg:w-40">
            <div class="flex gap-4 hidden xl:flex">
              <p class="text-red-800 font-bold"><%= (data.price).toLocaleString() %></p>
              <span
                class="bg-green-800 p-1 rounded-md text-white flex justify-center items-center"
              >
                Quality like no order</span
              >
            </div>
            <p class="text-green-500  my-2 font-bold">in stock</p>
            <div class="flex justify-between items-center">
              <p class="text-[9px] font-bold">Quantity</p>
              <div class="flex"> 
                <div id="Remove-Qnt" class="p-1 px-2 rounded-sm border border-gray-500 cursor-pointer">
                  -
                </div>
                <div id="Qnt" class="QNT p-1 border border-gray-300">1</div>
                <div id="Add-Qnt" class="p-1 px-2 rounded-sm border border-gray-500 cursor-pointer">
                  +
                </div>
              </div>
            </div>
            <% if (typeof user !== 'undefined' && user) { %>
              <button   id="Add-Cart" data-id="<%= data.id %>"   data-product='<%= JSON.stringify(user[0]) %>'
                class="w-full bg-blue-500 text-white hover:bg-blue-400 rounded-md flex justify-center gap-2 items-center text-xs cursor-pointer px-2  p-1 my-2 transition-all disabled:opacity-75 disabled:cursor-not-allowed">
                <!-- Loading Spinner (hidden by default) -->
                <svg id="cart-spinner"  class="hidden animate-spin h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg"  fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>

                <!-- Default Content -->
                <span id="btn-content" class="flex items-center gap-2">
                  <i class="bi bi-bag-check"></i>
                  Add to Cart
                </span>
              </button>
        
            <%}else{%>
             <button   id="Add-Cart" data-id="<%= data.id %>"   data-product='undefined'
                class="w-full bg-blue-500 text-white hover:bg-blue-400 rounded-md flex justify-center gap-2 items-center text-xs cursor-pointer px-2  p-1 my-2 transition-all disabled:opacity-75 disabled:cursor-not-allowed">
                <!-- Loading Spinner (hidden by default) -->
                <svg id="cart-spinner"  class="hidden animate-spin h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg"  fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>

                <!-- Default Content -->
                <span id="btn-content" class="flex items-center gap-2">
                  <i class="bi bi-bag-check"></i>
                  Add to Cart
                </span>
              </button>
              <%}%>
            <a href="" id="whatsappItem"
              class=" w-full border border-blue-500 rounded-md hover:bg-gray-300 flex justify-center gap-2 items-center text-xs cursor-pointer p-1 px-2 my-2"
            ><i class="bi bi-whatsapp"></i>
              Buy now
          </a>

            <div>
              <div class="flex items-center gap-2">
                <i
                  class="bi bi-arrow-clockwise text-blue-500 text-blue-500 text-[1.1rem]"
                ></i>
                <div>
                  <p class="font-bold ">30 days Return</p>
                  <p class="text-gray-500 ">Able returning</p>
                </div>
              </div>
              <div class="flex items-center gap-2 my-2">
                <i
                  class="bi bi-shield-check text-blue-500 text-blue-500 text-[1.1rem]"
                ></i>
                <div>
                  <p class="font-bold ">1 Year Warranty</p>
                  <p class="text-gray-500 ">
                    Quality product you can trust
                  </p>
                </div>
              </div>
              <div class="flex items-center gap-2 my-2">
                <i
                  class="bi bi-headset text-blue-500 text-blue-500 text-[1.1rem]"
                ></i>
                <div>
                  <p class="font-bold">Expert Support</p>
                  <p class="text-gray-500">Able returning</p>
                </div>
              </div>
            </div>
          </div>
          </div>
        </div>

        <div
          class="bg-[url('/blogbg.png')] bg-no-repeat bg-center bg-cover rounded-md w-full h-25 phone3:h-27 phone4:h-30 leading-loose my-3 p-4"
        >
          <h2 class="font-bold text-xs text-white tracking-widest">Transform your Drive</h2>
          <p class="text-[9px] text-white tracking-widest">Smart. Connected. Entertained</p>
          <div class="text-[12px] text-white flex items-center gap-2 phone4:my-4 tracking-wider">
            <div class="flex flex-col items-center">
              <i class="bi bi-send text-blue-300"></i>
              <p class="text-[9px]">Navigation</p>
            </div>
            <div class="flex flex-col items-center">
              <i class="bi bi-music-note-beamed text-blue-300"></i>
              <p class="text-[9px]">Music</p>
            </div>
            <div class="flex flex-col items-center">
              <i class="bi bi-telephone text-blue-300"></i>
              <p class="text-[9px]">Hand-Free</p>
            </div>
            <div class="flex flex-col items-center">
              <i class="bi bi-wifi text-blue-300"></i>
              <p class="text-[9px]">Wi-fi</p>
            </div>
          </div>
        </div>

        <div>
          <div class="flex justify-between text-xs">
            <p class="font-bold">You May Also Like</p>
            <p class="md:hidden"></p>
            <a class="text-blue-500 cursor-pointer hidden md:block" href="/android-stereo/product-page">View all products</a>
          </div>
          <div class="p-2 flex flex-wrap justify-center items-center gap-3 text-[10px]">
              <h2 id="loading" class='text-xl my-10 text-gray-400'><b>Loading...</b></h2>

            <% if(options && options.length > 0){%>
              <% options.forEach( result => {%>
            <div  id="box-container" class="w-40 border border-gray-300 rounded-md p-3 flex flex-col items-center hover:scale-105">
              <div class="w-20 my-2">
                <img src='<%= result.GoodsImage %>' class="w-full" alt="" />
              </div>
              <div class="w-full">
              <h2 class="font-bold"><%= result.GoodsName%></h2>
              <p class="text-gray-500">170" wide Angle</p>
              <a href="/android-stereo/productDetail-page/<%= result.id%>" class="w-full p-1 cursor-pointer hover:bg-blue-400 rounded-md bg-blue-500 text-white flex justify-center items-center">View Item</a>
            </div>
            </div>
            <%})%>
            <% }else{%>

               <div id="empty-box" class="rounded-md border-dashed border-gray-500 p-2 flex justify-between gap-2  my-1 phone2:flex-col  phone2:items-center">
                <img src="/box.png" class="w-[60px] md:w-[80px]" alt="">                
                <h2 class="font-bold text-[15px]  text-gray-500 my-2">No item to be displayed</h2>
              </div>
               <% } %>
          </div>
          <p class="flex justify-center items-center p-2 md:hidden"><a class="text-blue-500 text-xs" href="/product-page">View all products</a></p>
        </div>
      </div>
    </div>

    <%- include('../partial/footer') %>
<script src="/productDetails.js">

</script>

    <script
      src="https://kit.fontawesome.com/f5a408866e.js"
      crossorigin="anonymous"
    ></script>
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    />
  </body>
</html>
