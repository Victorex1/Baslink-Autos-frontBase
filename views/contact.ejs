<!DOCTYPE html>
<html lang="en">
<%- include('../partial/head') %>

<body class="w-screen h-screen bg-white">
     <%- include('../partial/nav') %>

     <div class="flex flex-col justify-center items-center w-full">
     <section class="bg-[url('/contactbg.png')] text-white flex justify-center  bg-no-repeat bg-center bg-cover  p-5 px-8 w-full  h-40 sm:h-60 lg:h-80 ">
        <div class=" w-full lg:w-[1024px]">
       <h1 class="text-[30px] sm:text-[40px] md:text-[50px]">Contact us</h1>
       <div class="text-[10px] sm:text-[15px] md:text-[20px]  text-gray-200 my-2 ">
        <a href="/android-stereo/home-page" > Home page </a> &gt;
        <a href="/contact-page"> Contact Us</a>
       </div>
       <p class="text-[12px] sm:text-[16px] md:text-[20px] text-gray-100 w-[190px] sm:w-[290px]">We're here to help! Get in touch with out team </p>
       </div>
     </section> 

     <section class="w-full p-3 px-8 flex flex-col  justify-center items-center lg:w-[1024px]">
        <div class="w-full my-4 "> 
            <div>
                <h2 class="text-[13px] font-bold">Get in Touch</h2>
                <p class="w-[240px] lg:w-[320px] text-[11px] md:text-[13px] lg:text-[15px]  my-2">Have a question or need assistant? Fill out the form and our team will get back to you as soon as possible</p>
            </div>
          <div class="flex flex-col sm:flex-row gap-2">
            <form action="" class="basis-1/2 text-[12px]">
                <div>
                  <label for="name" class="font-bold text-[12px] ">Your Name</label> 
                  <input type="text" id="name" name="name" placeholder="Full name" class="w-full h-7 lg:h-10 p-2 text-[12px] text-gray-700 rounded-md border-2 border-gray-300 my-1"  required>
                </div>
                <div>
                  <label for="subject" class="font-bold text-[12px]">Subject</label>
                  <input type="text" name="subject" id="subject" class="w-full h-7 lg:h-10 p-2 text-[12px] text-gray-700 rounded-md border-2 border-gray-300 my-1" placeholder="e.g, Product Inquiry or others" required>
                </div>
                <div>
                  <label for="message" class="font-bold text-[12px] ">Message</label>
                  <textarea name="message" id="message"  class="w-full h-30 p-2 text-[12px] text-gray-700 rounded-md border-2 border-gray-300 my-1" placeholder=" Type your Message here" required></textarea>
                </div>
                <button id="formSubmit" class="cursor-pointer text-white w-full rounded-md bg-blue-600 p-2 h-9 flex justify-center gap-2 items-center my-2"><i class="bi bi-whatsapp"></i>Send message on WhatsApp</button>
            </form>

            <div class="w-full border-2 text-[13px] border-gray-200 rounded-sm p-2 sm:basis-1/2">
               <h1 class="text-[13px]  font-bold">Contact Information </h1>
               <div class="my-2">
                <div class="flex my-4 sm:my-6 items-center">
                   <i class="fa-solid fa-phone mr-2  text-blue-600"></i>
                    <div class="">
                        <h2 class="font-bold ">Phone</h2>
                    <p class="text-[12px] ">+234-812-575-4371</p>

                    </div>
                </div >
                <div class="flex my-4 sm:my-6  items-center">
                    <i class="fa-regular fa-envelope text-blue-600 mr-2" ></i>
                    <div>
                      <h2 class="font-bold ">Email</h2>
                        <p class="">example@gmail.com  </p>
                    </div>
                </div>
                <div class="flex my-4 sm:my-6  items-center">
                    <i class="fa-solid fa-location-dot text-blue-600 mr-3"></i>
                <div>
                    <h2 class="font-bold"> Head Office</h2>
                    <p class="text-[12px] ">Zone A 12A, Shop 22 Aspmda Plaza Int'l trade fair complex badagry Express Way, Lagos</p>
                </div>
                 </div>
               </div>

            </div>
            </div>
          </div>
        
        <div class="w-full flex flex-col sm:flex-row gap-2">
          <div class="border-2 border-gray-200 rounded-sm p-2 my-2 sm:basis-1/3">
            <h2 class="font-bold my-3 lg:text-[15px]">Business Hours</h2>
            <div class="w-full">
                <div class="flex sm:flex-col sm:justify-start sm:items-start  md:flex-row sm:mb-4 justify-between md:justify-between items-center text-[12px] lg:text-[15px] my-2">
                    <p class="">Monday - Friday</p>
                    <p class="text-gray-600"> 9:00 am - 4:30 pm</p>
                </div>
                <div class="flex sm:flex-col sm:justify-start sm:items-start  md:flex-row justify-between md:justify-between items-center text-[12px] lg:text-[15px] my-2">
                    <p class="">Satuday - Sunday</p>
                    <p class="text-gray-600"> Closed</p>
                </div>
            </div>
          </div>
          <div class="w-full h-[300px] sm:h-[160px] my-3 rounded-sm border-2 border-gray-200 sm:basis-2/3">
<iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3964.4081001393715!2d3.24106595404729!3d6.469877344288659!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x103b8613d5c0f00b%3A0x297aa1d3c63fab25!2sAspamda%20Main%20gate%20trade%20fair%2C%20Trade%20Fair%20Complex%2C%20Satellite%20Town%20102102%2C%20Lagos!5e0!3m2!1sen!2sng!4v1783201547717!5m2!1sen!2sng"width="100%" height="100%"style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe>
          </div>

        </div>
     </section>
    </div>
    <%- include('../partial/footer') %>

    <script src="/contact.js"></script>

</body>
</html>